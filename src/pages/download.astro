---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { downloadAvailable, downloadUrl, version } from '../data/release';
---

<Layout title={downloadAvailable ? "Download FlowTree for macOS — beta" : "FlowTree for macOS — beta coming soon"} description={downloadAvailable ? "Download the FlowTree beta for macOS." : "The FlowTree beta for macOS is coming soon."}>
  <Navbar />
  <main>
    <PageHero eyebrow={downloadAvailable ? "Public beta" : "Beta"} title={downloadAvailable ? "Download FlowTree for macOS." : "The FlowTree beta is coming soon."} />

    <section class="section-tight">
      <div class="narrow">
        <div class="section-heading"><p class="eyebrow">Beta</p><h2>FlowTree is beta software.</h2></div>
        <p class="lede">This is an early beta, so expect bugs and rough edges, and things may change or break between versions. Keep your work committed and pushed, and don't rely on FlowTree for anything critical yet. If something goes wrong, email <a href="mailto:nebuliftapp@gmail.com">nebuliftapp@gmail.com</a> so we can fix it.</p>
        {downloadAvailable ? (
          <>
            <div class="button-row">
              <a class="button button-primary" href={downloadUrl}>Download FlowTree {version} beta (.dmg)</a>
            </div>
            <p class="fine" style="margin-top:22px">Open the disk image, drag FlowTree into your Applications folder, then open it.</p>
          </>
        ) : (
          <p class="fine" style="margin-top:22px">The download will be available here shortly.</p>
        )}
      </div>
    </section>

    <section class="section section-border">
      <div class="container">
        <div class="section-heading center"><p class="eyebrow">System requirements</p><h2>What FlowTree needs to run.</h2></div>
        <div class="card-grid">
          <article class="card"><h3>macOS 26 or later</h3><p>FlowTree is built for Apple Silicon Macs. Intel Macs are not supported by the app.</p></article>
          <article class="card"><h3>Git</h3><p>FlowTree uses your local Git installation, including its existing remotes and authentication.</p></article>
          <article class="card"><h3>tmux</h3><p>Required for persistent embedded terminal sessions. Worktree and branch management can be used without it.</p></article>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
