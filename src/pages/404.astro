---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Page not found — FlowTree" description="The page you were looking for could not be found." noindex>
  <Navbar />
  <main>
    <PageHero eyebrow="404" title="Page not found." description="The page you were looking for has moved or was never here.">
      <div class="button-row">
        <a class="button button-primary" href={base}>Back to home</a>
        <a class="button button-secondary" href={`${base}faq/`}>Read the FAQ</a>
      </div>
    </PageHero>
  </main>
  <Footer />
</Layout>
