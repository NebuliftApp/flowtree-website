---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import ProductMedia from '../components/ProductMedia.astro';
import CTA from '../components/CTA.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Features — FlowTree" description="Persistent terminals, quick commands, linked files, code review, and branch planning in FlowTree.">
  <Navbar />
  <main>
    <PageHero eyebrow="Features" title="Terminals, code review, and branch planning." description="Run commands and review changes in each worktree. Plan dependent branches and choose reference files for agent sessions." />

    <section id="terminals" class="section">
      <div class="container split">
        <div class="split-copy">
          <p class="eyebrow">Terminals</p>
          <h2>Run several terminal sessions in one worktree.</h2>
          <p class="lede">Open a shell, tests, a server, or an AI CLI in separate tabs. Each starts in that worktree's directory. Sessions can keep running when you close FlowTree, then reconnect when you return.</p>
        </div>
        <div class="terminal-group-media">
          <ProductMedia kind="image" src="images/terminal-group.png" alt="Four terminal tabs attached to a Cedarboard worktree, with one AI session selected beside planning, worktree-check, and recent-commits sessions." ratio="wide" width={1644} height={850} />
        </div>
      </div>
    </section>

    <section id="terminal-profiles" class="section section-border">
      <div class="container split">
        <div class="split-copy">
          <p class="eyebrow">Terminal profiles</p>
          <h2>Start your usual tools with a saved profile.</h2>
          <p class="lede">Create a named preset for an AI CLI or any command you open often. Choose it when starting a terminal tab instead of retyping the command.</p>
          <p>Give profiles a colour and set a default for the one you use most.</p>
        </div>
        <figure class="product-media terminal-profiles-media">
          <img src={`${base}images/terminal-profiles.png`} alt="Saved terminal profiles for Claude, Codex, and Gemini, with Claude Fable marked as the default." width="620" height="384" loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <section id="quick-commands" class="section section-border">
      <div class="container split">
        <div class="split-copy">
          <p class="eyebrow">Quick commands</p>
          <h2>Run frequent tasks from the worktree sidebar.</h2>
          <p class="lede">Terminal profiles start your usual tools when you open a tab. Quick commands are for tasks you run repeatedly in a project, such as running tests, starting a development server, or checking Git status.</p>
          <p>Save each command once, then launch it from any of the project's worktrees as a named terminal tab.</p>
        </div>
        <div class="quick-command-captures">
          <figure><img src={`${base}images/quick-commands-settings.png`} alt="Cedarboard's saved quick commands: Run tests, Check worktree, and Recent commits, each with its command shown." width="1240" height="630" loading="lazy" decoding="async" /></figure>
          <figure><img src={`${base}images/quick-commands-sidebar.png`} alt="The same three quick commands in the FlowTree worktree sidebar, ready to launch." width="630" height="306" loading="lazy" decoding="async" /></figure>
        </div>
      </div>
    </section>

    <section id="linked-context" class="section section-border">
      <div class="container split">
        <figure class="product-media context-session-media">
          <img src={`${base}images/context-session-selection.png`} alt="New Terminal Tab dialog with Architecture and Product brief selected as linked files for a Claude session, while Release checklist remains unselected." width="500" height="623" loading="lazy" decoding="async" />
        </figure>
        <div class="split-copy">
          <p class="eyebrow">Linked context · Pro</p>
          <h2>Choose reference files for an agent session.</h2>
          <p class="lede">Save links to files and folders against a project or worktree. When starting a compatible Claude Code, Codex, Copilot, or Gemini profile, choose which files to reference and folders to make available.</p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="split-copy">
          <p class="eyebrow">Code review</p>
          <h2>Review and stage changes before committing.</h2>
          <p class="lede">The review screen shows staged and unstaged files separately, with unified or side-by-side diffs.</p>
          <ul class="check-list">
            <li>Stage whole files, or stage individual hunks and lines with Pro.</li>
            <li>Commit, amend, or commit and push from the same screen.</li>
            <li>Open a changed file in your editor when it needs more work.</li>
          </ul>
        </div>
        <div class="feature-capture"><ProductMedia kind="image" src="images/cedarboard-review.png" alt="FlowTree review screen for Cedarboard showing staged and unstaged files, an added file, a deleted file, a renamed document, and three separate staged diff hunks." ratio="app" width={3024} height={1964} cropCapture /></div>
      </div>
    </section>

    <section class="section section-border">
      <div class="container">
        <div class="section-heading center">
          <p class="eyebrow">Merge queues · Pro</p>
          <h2>Plan the order of dependent branches.</h2>
          <p>A merge queue shows which branch depends on which, its review status, and a suggested order. You still choose when to merge.</p>
        </div>
        <ProductMedia
          kind="image"
          src="images/merge-queue.png"
          alt="Cedarboard merge queue showing five branches, including a three-branch dependency chain and two parallel entries."
          ratio="app"
          width={3024}
          height={1964}
          cropCapture
        />
        <div class="card-grid" style="margin-top:28px">
          <article class="card"><h3>Set review status</h3><p>Mark a branch Awaiting Review, Comments, or Needs Work. You can edit the status names.</p></article>
          <article class="card"><h3>Review each branch's own changes</h3><p>Compare an entry against the branch beneath it in the stack, or attach a pull-request link.</p></article>
          <article class="card"><h3>Share the plan</h3><p>Export the queue as Markdown with dependencies and suggested merge order.</p></article>
        </div>
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
</Layout>
