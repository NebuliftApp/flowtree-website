---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import licenses from '../data/third-party-licenses.json';

// Copied from the app's bundled acknowledgements
// (flowtree-ios: Packages/Features/Sources/FeatureSettings/Resources/ThirdPartyLicenses.json).
// Keep the two in sync when dependencies change.
interface License {
  group: 'app' | 'terminal';
  name: string;
  version: string;
  license: string;
  url: string;
  text: string;
}

const base = import.meta.env.BASE_URL;
const entries = licenses as License[];
const groups = [
  { id: 'app', title: 'FlowTree', description: 'Libraries compiled into the FlowTree application.' },
  { id: 'terminal', title: 'Terminal engine (Ghostty)', description: "Components of the build of Ghostty's terminal library that powers FlowTree's embedded terminals." },
].map((group) => ({ ...group, entries: entries.filter((entry) => entry.group === group.id) }));
---

<Layout title="Open-source licences — FlowTree" description="The third-party open-source components included in FlowTree and the full text of their licences.">
  <Navbar />
  <main>
    <PageHero eyebrow="Open source" title="The components we build on." description="FlowTree includes third-party open-source software. Each component remains the property of its authors and is used under the licence reproduced below." />

    <section class="section-tight">
      <div class="narrow">
        <p class="fine">The same list is available in the app under Settings → About → Third-Party Licenses. See the <a class="text-link" href={`${base}terms/`}>terms</a> for the licence covering FlowTree itself.</p>
      </div>
    </section>

    {groups.map((group, index) => (
      <section class={index === 0 ? 'section' : 'section section-border'} id={group.id}>
        <div class="narrow">
          <div class="section-heading"><p class="eyebrow">{group.entries.length} components</p><h2>{group.title}</h2><p>{group.description}</p></div>
          <div class="faq-list">
            {group.entries.map((entry) => (
              <details class="faq-item">
                <summary>
                  <span class="license-title">{entry.name} <span class="license-version">{entry.version}</span></span>
                  <span class="license-badge">{entry.license}</span>
                </summary>
                <div class="faq-answer">
                  <p><a class="text-link" href={entry.url} rel="noopener">{entry.url}</a></p>
                  <pre class="license-text">{entry.text}</pre>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    ))}
  </main>
  <Footer />
</Layout>

<style>
  .license-title { flex: 1; min-width: 0; }
  .license-version { margin-left: 6px; color: var(--text-3); font-weight: 500; font-size: .88rem; }
  .license-badge { align-self: center; flex-shrink: 0; padding: 4px 9px; border: 1px solid var(--line-bright); border-radius: 999px; color: var(--text-2); font-size: .74rem; font-weight: 650; white-space: nowrap; }
  .license-text {
    max-height: 420px;
    overflow: auto;
    margin: 0;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
    color: var(--text-2);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: .78rem;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  @media (max-width: 640px) {
    .license-badge { white-space: normal; text-align: right; }
  }
</style>
