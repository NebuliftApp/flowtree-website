---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Create Git worktrees — FlowTree" description="Create a worktree from a new or existing branch and copy the local files your project needs.">
  <Navbar />
  <main>
    <PageHero eyebrow="Worktrees" title="Give each task its own working directory." description="Keep a feature, an urgent fix, and a review open in the same repository without switching one directory between branches.">
      <div class="button-row"><a class="button button-primary" href="#create">Create a worktree ↓</a><a class="button button-secondary" href={`${base}features/`}>See other features</a></div>
    </PageHero>

    <section id="create" class="section section-border">
      <div class="container">
        <div class="section-heading center">
          <p class="eyebrow">Create a worktree</p>
          <h2>Start from a new or existing branch.</h2>
          <p>Choose a base for a new branch, or select a branch already in the repository. FlowTree shows the worktree name and destination before creating the directory.</p>
        </div>
        <div class="creation-paths">
          <figure class="creation-path">
            <figcaption><span>01 / New branch</span><strong>Start a task from a base branch.</strong></figcaption>
            <img src={`${base}images/worktree-new.png`} alt="FlowTree's Create Worktree dialog with New Branch selected, a worktree name, new branch name, base branch, group, and destination filled in." width="1210" height="1266" loading="lazy" decoding="async" />
          </figure>
          <figure class="creation-path">
            <figcaption><span>02 / Existing branch</span><strong>Check out a branch already in the repository.</strong></figcaption>
            <img src={`${base}images/worktree-existing.png`} alt="FlowTree's Create Worktree dialog with Existing Branch selected and the branch picker awaiting a selection." width="1198" height="1066" loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container split">
        <figure class="product-media copy-files-media">
          <img src={`${base}images/worktree-file-copy.png`} alt="FlowTree's worktree-file picker for lol-journal showing 47 selected local files, a search field, and individual file choices." width="1236" height="944" loading="lazy" decoding="async" />
        </figure>
        <div class="split-copy">
          <p class="eyebrow">Local setup files</p>
          <h2>Copy local setup files into new worktrees.</h2>
          <p class="lede">Git checks out tracked files. FlowTree can also copy the untracked and Git-ignored files you select, such as local configuration your project needs to run.</p>
          <ul class="check-list">
            <li>Choose files during worktree creation or in project Settings.</li>
            <li>Reuse the selection for future worktrees in that project.</li>
            <li>Generated paths are excluded by default; you can change the selection.</li>
          </ul>
          <p>You can also run a project setup command after creation, such as installing dependencies.</p>
        </div>
      </div>
    </section>
    <CTA />
  </main>
  <Footer />
</Layout>
