---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProductMedia from '../components/ProductMedia.astro';
import CTA from '../components/CTA.astro';

const base = import.meta.env.BASE_URL;
---

<Layout>
  <Navbar />
  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Git worktree app for macOS</p>
          <h1>Worktrees, terminals, and <span class="accent-text">code review.</span></h1>
          <p class="lede">Give each task its own working directory. FlowTree keeps its branch, changed files, and terminal sessions in one view, using the Git, editor, and CLI tools already on your Mac.</p>
          <div class="button-row">
            <a class="button button-primary" href={`${base}worktrees/`}>See how worktrees work →</a>
            <a class="button button-secondary" href={`${base}download/`}>Release status</a>
          </div>
          <div class="trust-row" aria-label="Product attributes">
            <span class="trust-pill">Native macOS app</span>
            <span class="trust-pill">Local Git repositories</span>
            <span class="trust-pill">No FlowTree cloud</span>
          </div>
        </div>
        <div class="hero-media">
          <ProductMedia
            kind="image"
            src="images/flowtree-hero.png"
            alt="FlowTree showing worktrees, a branch's changed files, and terminal tabs in one window."
            ratio="app"
            width={3024}
            height={1964}
            cropCapture
            eager
          />
          <p class="media-caption">FIG. 01 <span>Cedarboard · worktrees · branch status · terminal</span></p>
        </div>
      </div>
    </section>

    <section class="section section-border">
      <div class="container worktree-story">
        <div class="section-heading">
          <p class="eyebrow">Terminal sessions</p>
          <h2>Keep each task's terminals together.</h2>
          <p>Open a shell, tests, or an AI CLI in separate tabs for a worktree. Switch to another task without closing those sessions or changing the files in the first worktree.</p>
          <a class="text-link" href={`${base}features/#terminals`}>How terminal sessions work →</a>
        </div>
        <div class="terminal-group-media">
          <ProductMedia kind="image" src="images/terminal-group.png" alt="Four terminal tabs attached to a Cedarboard worktree, with one AI session selected beside planning, worktree-check, and recent-commits sessions." ratio="wide" width={1644} height={850} />
          <p class="media-caption">FIG. 02 <span>One worktree · several terminal sessions</span></p>
        </div>
      </div>
    </section>

    <section class="section section-border">
      <div class="container split">
        <div class="split-copy">
          <p class="eyebrow">Project tools</p>
          <h2>Run saved commands from the worktree sidebar.</h2>
          <p class="lede">Save commands such as <code>npm test</code> or <code>git status</code> for a project. They appear in its worktrees and open as named terminal tabs.</p>
          <div class="button-row">
            <a class="button button-secondary" href={`${base}features/#quick-commands`}>How quick commands work</a>
          </div>
        </div>
        <div class="quick-command-captures">
          <figure>
            <img src={`${base}images/quick-commands-settings.png`} alt="Cedarboard's saved quick commands: Run tests, Check worktree, and Recent commits, each with its command shown." width="1240" height="630" loading="lazy" decoding="async" />
            <figcaption class="media-caption">FIG. 03 <span>Save commands for the project</span></figcaption>
          </figure>
          <figure>
            <img src={`${base}images/quick-commands-sidebar.png`} alt="The same three quick commands in the FlowTree worktree sidebar, ready to launch." width="630" height="306" loading="lazy" decoding="async" />
            <figcaption class="media-caption">FIG. 04 <span>Run them from the worktree</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section section-border">
      <div class="container split">
        <figure class="context-manager-media">
          <img src={`${base}images/context-manager-worktree.png`} alt="Manage Linked Context dialog showing Architecture saved for the Cedarboard worktree, with separate Project and This Worktree scopes." width="667" height="519" loading="lazy" decoding="async" />
        </figure>
        <div class="split-copy">
          <p class="eyebrow">Linked context · Pro</p>
          <h2>Select project files when starting an agent session.</h2>
          <p class="lede">Save paths to specs, schemas, or folders for a project or worktree. With a compatible Claude Code, Codex, Copilot, or Gemini profile, choose files to reference and folders the session can access.</p>
          <div class="button-row"><a class="text-link" href={`${base}features/#linked-context`}>See linked files and folders →</a></div>
        </div>
      </div>
    </section>

    <section class="section section-border">
      <div class="narrow">
        <div class="section-heading">
          <p class="eyebrow">Local by design</p>
          <h2>No FlowTree cloud for your repositories.</h2>
          <p>FlowTree reads and changes repositories on your Mac. It does not upload them to a FlowTree service or collect usage telemetry. Git remotes, the AI CLIs you run, and Pro licence checks use their own services.</p>
        </div>
        <div class="button-row"><a class="text-link" href={`${base}privacy/`}>How FlowTree handles your data →</a></div>
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'FlowTree',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS 26 or later',
    description: 'A native macOS app for Git worktrees, persistent terminal sessions, and code review.',
    offers: [
      {
        '@type': 'Offer',
        name: 'FlowTree Free',
        price: '0',
        priceCurrency: 'GBP',
      },
      {
        '@type': 'Offer',
        name: 'FlowTree Pro',
        price: '7.99',
        priceCurrency: 'GBP',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '7.99',
          priceCurrency: 'GBP',
          billingDuration: 'P1M',
          referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'MON' },
        },
      },
    ],
  })} />
</Layout>
