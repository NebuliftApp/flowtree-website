---
const base = import.meta.env.BASE_URL;
const contactEmail = 'nebuliftapp@gmail.com';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={base}>
          <img src={`${base}images/app-icon.png`} alt="" />
          <span>FlowTree</span>
        </a>
        <p>Organise worktrees, terminals, and code review by task.</p>
      </div>
      <div class="footer-column">
        <strong>Product</strong>
        <a href={`${base}worktrees/`}>Worktrees</a>
        <a href={`${base}features/`}>Features</a>
        <a href={`${base}pricing/`}>Pricing</a>
        <a href={`${base}download/`}>Release status</a>
      </div>
      <div class="footer-column">
        <strong>Help</strong>
        <a href={`${base}how-it-works/`}>How it works</a>
        <a href={`${base}faq/`}>FAQ</a>
        <a href={`mailto:${contactEmail}`}>Contact</a>
      </div>
      <div class="footer-column">
        <strong>Legal</strong>
        <a href={`${base}privacy/`}>Privacy</a>
        <a href={`${base}terms/`}>Terms &amp; refunds</a>
        <a href={`${base}licenses/`}>Open-source licences</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} Daniel Sims. All rights reserved.</span>
      <span>macOS app · Local repositories</span>
    </div>
  </div>
</footer>
