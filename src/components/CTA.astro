---
import { downloadAvailable } from '../data/release';
const base = import.meta.env.BASE_URL;
interface Props { title?: string; description?: string; }
const {
  title = downloadAvailable ? 'FlowTree is in public beta.' : 'The FlowTree beta is coming soon.',
  description = downloadAvailable
    ? 'Download it free for macOS. It works on one project for free, and Pro unlocks the rest.'
    : 'Free on one project, with Pro for the rest. The download will be here shortly.',
} = Astro.props;
---

<section class="section section-border">
  <div class="container">
    <div class="cta-panel">
      <div>
        <p class="eyebrow">{downloadAvailable ? 'Download' : 'Beta'}</p>
        <h2>{title}</h2>
        <p>{description}</p>
      </div>
      <div class="button-row">
        <a class="button button-primary" href={`${base}download/`}>{downloadAvailable ? 'Download FlowTree →' : 'Beta coming soon →'}</a>
      </div>
    </div>
  </div>
</section>
