---
const base = import.meta.env.BASE_URL;
interface Props { title?: string; description?: string; }
const {
  title = 'FlowTree is in pre-release testing.',
  description = 'The release page will have the installer and system requirements when the public build is ready.',
} = Astro.props;
---

<section class="section section-border">
  <div class="container">
    <div class="cta-panel">
      <div>
        <p class="eyebrow">Release status</p>
        <h2>{title}</h2>
        <p>{description}</p>
      </div>
      <div class="button-row">
        <a class="button button-primary" href={`${base}download/`}>Release status →</a>
      </div>
    </div>
  </div>
</section>
